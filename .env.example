# ElevenLabs Configuration
# Get your API key from https://elevenlabs.io
ELEVEN_LABS_API_KEY=sk_your_api_key_here

# Optional: Specify the TTS model
# Options: eleven_monolingual_v1 (default), eleven_turbo_v2
ELEVEN_LABS_MODEL_ID=eleven_monolingual_v1

# Output directory for generated audio files
# Default: ./output
OUTPUT_DIR=./output

# Bible version for scripture lookups (if using scripture-curated skill)
# Options: ESV, NIV, KJV, NASB, NRSV, CSB
BIBLE_VERSION=ESV

# Logging level
# Options: error, warn, info, debug
LOG_LEVEL=info

# Enable debug logging for this skill
DEBUG=voice-devotional:*

# Optional: Default voice preset
# Options: josh (devotional), chris (teaching), bella (meditation)
DEFAULT_VOICE=josh

# Optional: Rate limiting
# Delay in milliseconds between API requests (default: 1000)
API_RATE_LIMIT_MS=1000

# Optional: Cache directory for downloaded scripture (if using external API)
# CACHE_DIR=./cache

# Optional: Enable audio file compression
# COMPRESS_AUDIO=true
