#!/bin/bash
# play-devotional - Generate, play in QuickTime, auto-delete when done

THEME=${1:-peace}
VOICE=${2:-josh}

cd ~/clawd/skills/voice-devotional

# Generate devotional
echo "🎙️ Generating $THEME devotional..."
node -e "
const VoiceDevotion = require('./scripts/voice-devotional');
const vd = new VoiceDevotion({
  apiKey: process.env.ELEVEN_LABS_API_KEY,
  outputDir: './output'
});

vd.generateDaily({
  theme: '$THEME',
  voiceId: '$VOICE',
  format: 'audio'
}).then(result => {
  console.log('FILE:' + result.audioPath);
  console.log('DURATION:' + result.lesson.estimatedDuration);
  console.log('SCRIPTURE:' + result.lesson.scripture);
}).catch(err => {
  console.error('ERROR:' + err.message);
  process.exit(1);
});
" 2>&1 | while read line; do
  if [[ $line == FILE:* ]]; then
    FILE="${line#FILE:}"
  elif [[ $line == DURATION:* ]]; then
    DURATION="${line#DURATION:}"
  elif [[ $line == SCRIPTURE:* ]]; then
    SCRIPTURE="${line#SCRIPTURE:}"
  elif [[ $line == ERROR:* ]]; then
    echo "❌ ${line#ERROR:}"
    exit 1
  fi
done

# Copy to desktop with nice name
if [ -f "$FILE" ]; then
  TIMESTAMP=$(date +"%Y-%m-%d")
  DESKTOP_FILE="$HOME/Desktop/Devotional-${THEME}-${TIMESTAMP}.mp3"
  cp "$FILE" "$DESKTOP_FILE"
  echo "✓ Saved to Desktop"
  
  # Play in QuickTime Player
  echo "▶️  Playing in QuickTime Player..."
  echo "🙏 $SCRIPTURE"
  echo "⏱️  ~$((DURATION/60)) minutes"
  echo ""
  
  # Open in QuickTime
  open -a "QuickTime Player" "$DESKTOP_FILE"
  
  # Wait for playback to finish (duration + 10 sec buffer), then delete
  SLEEP_TIME=$((DURATION + 10))
  echo "⏳ Playing... will auto-delete in ~$((SLEEP_TIME/60)) min"
  
  sleep $SLEEP_TIME
  
  # Close QuickTime and delete file
  if [ -f "$DESKTOP_FILE" ]; then
    osascript -e 'tell application "QuickTime Player" to quit' 2>/dev/null
    sleep 2
    rm "$DESKTOP_FILE"
    echo ""
    echo "✅ Devotional complete. File cleaned up."
  fi
fi
